# Beispielkonfiguration fuer den Containerbetrieb.
#
#     cp .env.example .env
#
# Alle Werte sind optional. Was hier auskommentiert bleibt, benutzt die
# Vorgabe des Servers - die Vorgaben stehen deshalb bewusst nur an einer
# Stelle, naemlich im Server selbst, und sind hier nur als Hinweis notiert.
#
# Dieselben Variablen wirken auch ohne Compose:
#
#     docker run --rm --network host -e CORPSHOOT_NAME="Daily Standup" <bild>

# Port fuer HTTP und WebSocket. 0 waehlt einen freien Port.
# Vorgabe: 4200
#CORPSHOOT_PORT=4200

# Adresse, an die gebunden wird. Im Container muss das 0.0.0.0 bleiben,
# sonst ist der Server von aussen nicht erreichbar.
# Vorgabe: 0.0.0.0
#CORPSHOOT_BIND=0.0.0.0

# Name, unter dem der Server im LAN erscheint (mDNS und Startausgabe).
# Vorgabe: Corporate Shooter
#CORPSHOOT_NAME=Daily Standup

# Simulationsschritte pro Sekunde, erlaubt sind 1 bis 120. Im LAN reichen
# 20 bis 30; hoehere Werte kosten Bandbreite, ohne spuerbar besser zu sein.
# Vorgabe: 30
#CORPSHOOT_TICK_RATE=30

# mDNS-Bekanntmachung abschalten.
#
# Im Standard-Netzmodus von Docker (bridge) funktioniert mDNS ohnehin nicht,
# und der Server wuerde seine Container-Adresse verkuenden. Dort also auf
# true setzen. Mit "network_mode: host" - der Vorgabe in compose.yaml -
# kann es aus bleiben.
# Vorgabe: false
#CORPSHOOT_NO_MDNS=false

# Verzeichnis mit dem Browser-Client. Im Container liegt er unter /srv/client
# und wird von selbst gefunden; diese Variable braucht nur, wer den Client
# austauschen will.
#CORPSHOOT_CLIENT_DIR=/srv/client

# Fester Startwert fuer den Zufallsgenerator. Macht Waffenstreuung und
# Spawnauswahl reproduzierbar - fuer Tests gedacht, nicht fuer den Spielbetrieb.
#CORPSHOOT_SEED=12345
