# Beispielkonfiguration fuer den Containerbetrieb.
#
#     cp .env.example .env
#
# Alle Werte sind optional. Was hier auskommentiert bleibt, benutzt die
# Vorgabe des Servers - die Vorgaben stehen deshalb bewusst nur an einer
# Stelle, naemlich im Server selbst, und sind hier nur als Hinweis notiert.
#
# Dieselben Variablen wirken auch ohne Compose:
#
#     docker run --rm --network host -e CORPSHOOT_NAME="Daily Standup" <bild>

# Port fuer HTTP und WebSocket. 0 waehlt einen freien Port.
# Vorgabe: 4200
#CORPSHOOT_PORT=4200

# Adresse, an die gebunden wird. Im Container muss das 0.0.0.0 bleiben,
# sonst ist der Server von aussen nicht erreichbar.
# Vorgabe: 0.0.0.0
#CORPSHOOT_BIND=0.0.0.0

# Hoechstzahl gleichzeitiger Spieler.
#
# Im LAN eine Formalie, auf einem oeffentlich erreichbaren Server nicht: ohne
# Grenze haelt ein einzelner Gegenueber beliebig viele Verbindungen offen, und
# jede kostet einen Platz in jedem Snapshot.
# Vorgabe: 16
#CORPSHOOT_MAX_PLAYERS=16

# Name, unter dem der Server erscheint (mDNS und Startausgabe).
# Vorgabe: Corporate Shooter
#CORPSHOOT_NAME=Daily Standup

# Simulationsschritte pro Sekunde, erlaubt sind 1 bis 120.
#
# Ein feiner Takt kostet fast nichts und bringt viel: kuerzere Eingabewege und
# kleinere Schritte in der Vorhersage, also ein glatteres Bild. Bandbreite
# kostet er nicht - die haengt am Snapshot-Intervall.
# Vorgabe: 60
#CORPSHOOT_TICK_RATE=60

# Wie viele Simulationsschritte auf einen Snapshot kommen.
#
# Bei 60 Hz Takt und 2 gehen 30 Snapshots je Sekunde raus. Erhoehen spart
# Bandbreite auf Kosten der Darstellung fremder Spieler; auf 1 zu setzen
# verdoppelt die Bandbreite, ohne dass sich die eigene Bewegung aendert -
# die haengt an der Tickrate.
# Vorgabe: 2
#CORPSHOOT_SNAPSHOT_INTERVAL=2

# mDNS-Bekanntmachung abschalten.
#
# mDNS traegt nur im lokalen Netzsegment. Beim Serverbetrieb - der Vorgabe in
# compose.yaml - ist es abgeschaltet und dort auch nutzlos. Nur das Profil
# "lan" mit Host-Netz braucht es eingeschaltet.
# Vorgabe: false
#CORPSHOOT_NO_MDNS=false

# Verzeichnis mit dem Browser-Client. Im Container liegt er unter /srv/client
# und wird von selbst gefunden; diese Variable braucht nur, wer den Client
# austauschen will.
#CORPSHOOT_CLIENT_DIR=/srv/client

# Fester Startwert fuer den Zufallsgenerator. Macht Waffenstreuung und
# Spawnauswahl reproduzierbar - fuer Tests gedacht, nicht fuer den Spielbetrieb.
#CORPSHOOT_SEED=12345
