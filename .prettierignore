# Prettier formatiert die Logik des Clients und die Pruefskripte.
#
# Ausgenommen sind die Modelldaten: viewmodel.js, parts.js und figur.js
# beschreiben Waffen und Figuren als dichte Zeilen aus Masszahlen, und eine
# Zeile je Bauteil ist dort lesbarer als die zehn, die Prettier daraus machte.
# HTML und CSS sind von Hand gesetzt. Rust formatiert rustfmt, vendor ist
# nicht von hier.
*
!client/
!client/js/
!client/js/*.js
client/js/viewmodel.js
client/js/parts.js
client/js/figur.js
!scripts/
!scripts/*.mjs
!crates/
!crates/predict/
!crates/predict/tests/
!crates/predict/tests/*.mjs
!eslint.config.js
